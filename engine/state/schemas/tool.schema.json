{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool.schema.json",
  "title": "Interactive picker / troubleshooter (content/tools/<id>.json)",
  "description": "Questions with fixed options (an option can depend on earlier answers via showIf); the first rule whose `when` matches all its answers picks the result, else `default`. Rendered by the site's Picker component. Data only, no code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "questions", "results", "rules", "default"],
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$", "maxLength": 40 },
    "label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "showIf": {
      "description": "{ questionKey: value or [values] } of earlier questions; every key must match for the option to be shown.",
      "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/key" },
      "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/key" }, { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } }] }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["key", "text", "options"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "text": { "type": "string", "minLength": 1, "maxLength": 140 },
          "options": {
            "type": "array", "minItems": 2, "maxItems": 6,
            "items": {
              "description": "[value, label] or [value, label, showIf].",
              "oneOf": [
                { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "$ref": "#/$defs/key" }, { "$ref": "#/$defs/label" }] },
                { "type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{ "$ref": "#/$defs/key" }, { "$ref": "#/$defs/label" }, { "$ref": "#/$defs/showIf" }] }
              ]
            }
          }
        }
      }
    },
    "results": {
      "type": "object", "minProperties": 2,
      "propertyNames": { "$ref": "#/$defs/key" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["title", "text"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "text": { "type": "string", "minLength": 1, "maxLength": 400 },
          "productId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    },
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["when", "result"],
        "properties": {
          "when": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/key" } },
          "result": { "$ref": "#/$defs/key" }
        }
      }
    },
    "default": { "$ref": "#/$defs/key" }
  }
}
