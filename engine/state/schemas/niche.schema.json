{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "niche.schema.json",
  "title": "Niche configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "categories",
    "markets",
    "contentTypes",
    "commercialRoles",
    "sellers",
    "disclosures"
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "locale",
          "currency",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2}-[a-z]{2}$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "status": {
            "enum": [
              "primary",
              "secondary",
              "planned"
            ]
          },
          "names": {
            "description": "How readers name this market in text (\"UK\", \"British\"). Text shown in every market must not use them outside the sources section.",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "contentTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "commercialRoles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sellers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "market",
          "type"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "market": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "type": {
            "enum": [
              "affiliate",
              "direct"
            ]
          }
        }
      }
    },
    "disclosures": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "products",
        "why"
      ],
      "description": "The product cluster the site builds first: ideas start from the problems, upgrades and decisions of owners of these products.",
      "properties": {
        "products": {
          "type": "array",
          "description": "Starting list. Once data/focus/state.json exists, the focus review keeps the live list there.",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "angles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Kinds of owner questions to look for."
        },
        "pinned": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "description": "Products that always stay in focus."
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "description": "Products the focus review never adds."
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "description": "Focus review (engine/focus/focus.mjs). products is the starting list; data/focus/state.json holds the live one.",
          "properties": {
            "maxActive": { "type": "integer", "minimum": 1, "maximum": 10 },
            "coveredAfterGuides": { "type": "integer", "minimum": 1 },
            "reviewEveryDays": { "type": "integer", "minimum": 1 },
            "probeCandidates": { "type": "integer", "minimum": 1, "maximum": 30 },
            "probeQueries": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\{name\\}" } },
            "categories": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo"],
      "description": "Read-only product catalog repository (manufacturer versions, specs, manuals, troubleshooting). Each tick refreshes a local mirror in dir (gitignored) before agents run.",
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "dir": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "maxListed": { "type": "integer", "minimum": 1 }
      }
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the scheduler collects demand data (no AI) before the idea agent runs.",
      "properties": {
        "querySuffixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "queryPrefixes": {
          "type": "array",
          "description": "Question openings put before each focus product for autocomplete (\"why is my\").",
          "items": {
            "type": "string"
          }
        },
        "maxQueries": {
          "type": "integer",
          "minimum": 1
        },
        "searchBudgets": {
          "type": "object",
          "description": "Monthly request budget per search provider, shared by community search and People also ask.",
          "additionalProperties": false,
          "properties": {
            "tavily": { "type": "integer", "minimum": 0 },
            "serper": { "type": "integer", "minimum": 0 },
            "brave": { "type": "integer", "minimum": 0 }
          }
        },
        "peopleAlsoAsk": {
          "type": "object",
          "additionalProperties": false,
          "description": "Google's People also ask questions and related searches for the focus queries (SERPER_API_KEY).",
          "properties": {
            "maxQueries": { "type": "integer", "minimum": 1 }
          }
        },
        "webSearch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sites"
          ],
          "description": "Community sites searched through a web search API (TAVILY_API_KEY, SERPER_API_KEY or BRAVE_SEARCH_API_KEY, in providers order). Only search results are kept; the sites are never fetched.",
          "properties": {
            "sites": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}(/[A-Za-z0-9_/-]+)?$"
              }
            },
            "maxQueries": {
              "type": "integer",
              "minimum": 1
            },
            "monthlyMax": {
              "type": "integer",
              "minimum": 1,
              "description": "Default monthly budget for a provider missing from searchBudgets."
            },
            "providers": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["tavily", "serper", "brave"] }
            }
          }
        },
        "youtube": {
          "type": "object",
          "additionalProperties": false,
          "description": "YouTube videos and question comments (YOUTUBE_API_KEY).",
          "properties": {
            "maxSearches": {
              "type": "integer",
              "minimum": 1
            },
            "videosPerSearch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "commentsPerVideo": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "monthlyUnits": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Publishing policy. autoMerge: a publishing PR merges itself after vetoHours with green checks unless it carries the hold label.",
      "properties": {
        "autoMerge": {
          "type": "boolean"
        },
        "vetoHours": {
          "type": "number",
          "minimum": 1
        }
      }
    }
  }
}
