{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research.artifact.schema.json",
  "title": "Research note (rebuild-spec 5.3)",
  "description": "Research note. Knowledge-card changes come back in `cardChanges` (the agent has no write tools); the tick validates each card and refuses to drop existing claims, then writes it. `claimIds` must resolve to supported claims after the changes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "learned",
    "unknowns",
    "competitors",
    "claimIds"
  ],
  "properties": {
    "learned": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "says"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "says": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claimIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
        "description": "productId/claimId"
      }
    },
    "matrixCells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "matrix",
          "row",
          "column",
          "field"
        ],
        "properties": {
          "matrix": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "row": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "column": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "field": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cardChanges": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content",
          "summary"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^knowledge/[a-z0-9-]+/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
          },
          "content": {
            "type": "string",
            "minLength": 50,
            "description": "The complete card file: optional heading and summary plus exactly one fenced json block (knowledge/README.md)."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "What changed and why."
          }
        }
      }
    }
  }
}
