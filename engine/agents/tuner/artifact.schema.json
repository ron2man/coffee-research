{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tuner.artifact.schema.json",
  "title": "Prompt change proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "changes", "addresses", "notAddressed"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "newText", "why"],
        "properties": {
          "file": { "enum": ["prompt", "niche-guidance"], "description": "prompt = the niche-agnostic engine prompt; niche-guidance = niche-specific advice." },
          "newText": { "type": "string", "minLength": 50, "description": "The complete new file content." },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "addresses": { "type": "array", "items": { "type": "string" }, "description": "IDs of feedback entries this change addresses." },
    "notAddressed": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "why"],
        "properties": { "id": { "type": "string" }, "why": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
