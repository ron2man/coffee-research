{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "writer.artifact.schema.json",
  "title": "Draft (rebuild-spec 5.5, 6.5)",
  "description": "v0 contract. M4 renders this to content/drafts/<slug>.md + claims.json and adds lint (section 7). `post-judge` input is present only on a revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "description",
    "market",
    "language",
    "primaryQuery",
    "relatedQueries",
    "productIds",
    "tools",
    "body",
    "claims"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "market": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "primaryQuery": {
      "type": "string",
      "minLength": 1
    },
    "relatedQueries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "productIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 80
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 80
      }
    },
    "body": {
      "type": "string",
      "minLength": 200,
      "description": "Markdown body."
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "claimIds"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "claimIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
              "description": "productId/claimId"
            }
          }
        }
      }
    },
    "humanData": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "author",
          "date",
          "description"
        ],
        "properties": {
          "author": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "offerIds": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 80
      },
      "description": "Products the post recommends buying, shown in the 'Our pick' card and the 'Where to buy' box (first = the pick). Never the product the reader already owns. Empty when the answer is to buy nothing, or the right product isn't researched yet."
    }
  }
}
