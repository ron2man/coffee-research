{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idea.artifact.schema.json",
  "title": "Idea card (rebuild-spec 6.1)",
  "description": "Qualitative or measured demand needs at least one signal. No invented search volume.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "audience",
    "market",
    "language",
    "pain",
    "decision",
    "contentType",
    "demand",
    "competitorGap",
    "valueAdd",
    "commercialPath"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "pain": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "contentType": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "signals"
      ],
      "properties": {
        "kind": {
          "enum": [
            "measured",
            "qualitative",
            "unmeasured"
          ]
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "date",
              "note"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "competitorGap": {
      "type": "string",
      "minLength": 1
    },
    "valueAdd": {
      "type": "string",
      "minLength": 1
    },
    "commercialPath": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overlapsWith": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 80
      },
      "description": "Existing item or post IDs with similar intent."
    },
    "seedId": {
      "type": "string",
      "description": "The id of the human seed this card came from, if any."
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "demand"
        ],
        "properties": {
          "demand": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "measured",
                  "qualitative"
                ]
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "demand": {
            "type": "object",
            "properties": {
              "signals": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
