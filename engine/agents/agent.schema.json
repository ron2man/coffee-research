{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent.schema.json",
  "title": "Agent definition (engine/agents/<name>/agent.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "mode",
    "priority",
    "artifactDir",
    "runner"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "description": "generate: creates new items. batch: decides on all items in inputStatus in one run. item: processes one item. review: the critic, reviews another agent's recent output. tune: proposes prompt changes from open feedback.",
      "enum": [
        "generate",
        "batch",
        "item",
        "review",
        "tune"
      ]
    },
    "priority": {
      "type": "integer",
      "description": "Higher runs first. Later pipeline stages should outrank earlier ones so work finishes before new work starts."
    },
    "inputStatus": {
      "type": "string"
    },
    "outcomes": {
      "type": "object",
      "description": "Agent outcome name \u2192 item status.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "artifactDir": {
      "type": "string",
      "pattern": "^(data|content)/[a-z0-9-]+$"
    },
    "maxItems": {
      "type": "integer",
      "minimum": 1
    },
    "batchSize": {
      "type": "integer",
      "minimum": 1
    },
    "maxAdvance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "max"
      ],
      "description": "At most `max` decisions may use `outcome`. With `overflow`, extra ones are converted to that outcome (lowest `rankBy` score first) instead of failing the whole run.",
      "properties": {
        "outcome": {
          "type": "string"
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "overflow": {
          "type": "string"
        },
        "rankBy": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$",
          "description": "Artifact property whose values each carry a numeric `score`; their sum ranks decisions."
        }
      }
    },
    "queueCap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statuses",
        "max"
      ],
      "properties": {
        "statuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minIntervalHours"
      ],
      "properties": {
        "minIntervalHours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "limit",
        "exceeded"
      ],
      "description": "An outcome that sends the item back (e.g. revise). After `limit` loops it goes to `exceeded` instead.",
      "properties": {
        "outcome": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "exceeded": {
          "type": "string"
        }
      }
    },
    "inputArtifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of earlier agents whose artifacts are passed as input."
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "claude",
            "fake"
          ]
        },
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "description": "Read-only tools only. Agents never write files; the tick writes everything from their validated output.",
          "items": {
            "enum": [
              "Read",
              "Grep",
              "Glob",
              "WebSearch",
              "WebFetch"
            ]
          }
        },
        "permissions": {
          "type": "object"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutMinutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "nicheFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.md$"
      },
      "description": "Files from niches/<niche>/ appended to the instructions (e.g. style.md)."
    },
    "status": {
      "enum": [
        "draft",
        "active"
      ],
      "description": "draft = contract defined, prompt not yet written."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "description": "review mode: when a target agent's unreviewed outputs are due.",
      "properties": {
        "minEntries": {
          "type": "integer",
          "minimum": 1
        },
        "maxWaitHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxEntries": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tune": {
      "type": "object",
      "additionalProperties": false,
      "description": "tune mode: how much open feedback triggers a proposal.",
      "properties": {
        "minOpen": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "acceptsSeeds": {
      "type": "boolean",
      "description": "generate mode: receives open human seeds (data/seeds) as topic hints; a fresh seed brings a scheduled run forward."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "generate"
          }
        }
      },
      "then": {
        "required": [
          "maxItems"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "batch",
              "item"
            ]
          }
        }
      },
      "then": {
        "required": [
          "inputStatus",
          "outcomes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "batch"
          }
        }
      },
      "then": {
        "required": [
          "batchSize"
        ]
      }
    }
  ]
}
