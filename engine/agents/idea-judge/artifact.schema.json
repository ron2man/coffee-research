{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idea-judge.artifact.schema.json",
  "title": "Idea judge scores (rebuild-spec 5.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scores"
  ],
  "properties": {
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
