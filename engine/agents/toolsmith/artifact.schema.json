{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolsmith.artifact.schema.json",
  "title": "Tools built for one item",
  "description": "Each tool follows engine/state/schemas/tool.schema.json (checked by the scheduler). Every missing tool is either built or skipped with a reason.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tools", "skipped"],
  "properties": {
    "tools": { "type": "array", "maxItems": 3, "items": { "type": "object", "required": ["id"] } },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "why"],
        "properties": { "id": { "type": "string" }, "why": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
