# Copy to site/.env for local production builds (npm run site:build:production).
# On Cloudflare set the same names as build variables (Worker > Settings > Build > Variables and secrets).
# Neither value is a secret: both end up in the page HTML.
PUBLIC_GA4_ID=G-XXXXXXXXXX
# Optional: only if you verify Search Console with the HTML-tag method instead of DNS.
PUBLIC_GSC_VERIFICATION=
