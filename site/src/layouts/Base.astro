---
// The page shell: head (SEO, hreflang, analytics), masthead, footer. Every page uses it.
import { site } from '../data/load.mjs';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  path: string;                 // e.g. /en-us/guides/x/
  market?: any;                 // absent on the root chooser
  pageId?: string;              // guide slug, sent with analytics events
  bodyClass?: string;
  noindex?: boolean;
  image?: { src: string; alt: string; width: number; height: number }; // share image; default below
}
const { title, description, path, market, pageId, bodyClass, noindex, image } = Astro.props;
const { data, t, SITE_URL } = await site();
const { preview, production, markets } = data;
const siteInfo = data.site;
const { brandMark, navLabel, shortLabel, spokenName } = t;
const env = import.meta.env;
const gtm = production ? (env.PUBLIC_GTM_ID || process.env.PUBLIC_GTM_ID || '') : '';
const gscToken = env.PUBLIC_GSC_VERIFICATION || process.env.PUBLIC_GSC_VERIFICATION || '';
const robots = preview || noindex ? 'noindex, nofollow' : null;

// hreflang: the same page in every market that has it, plus x-default (the root chooser).
const alternates = market
  ? markets.map((m) => ({ m, href: path.replace(`/${market.locale}/`, `/${m.locale}/`) })).filter(({ href }) => siteInfo.pages.has(href))
  : markets.map((m) => ({ m, href: `/${m.locale}/` }));
// x-default: the same page in the first (primary) market when it exists; market homes keep the root chooser.
const primaryHref = market ? path.replace(`/${market.locale}/`, `/${markets[0].locale}/`) : null;
const isHome = market && path === `/${market.locale}/`;
const xDefault = !isHome && primaryHref && siteInfo.pages.has(primaryHref) ? primaryHref : '/';
const lang = market ? `${market.language}-${market.id}` : 'en';
const ogLocale = market ? `${market.language}_${market.id}` : 'en_US';
const switcher = market ? markets.map((m) => {
  const target = path.replace(`/${market.locale}/`, `/${m.locale}/`);
  return { m, href: siteInfo.pages.has(target) ? target : `/${m.locale}/` };
}) : [];
const disclosure = market ? siteInfo.disclosure(market) : null;
const hasGuides = siteInfo.pages.has(`/${market?.locale}/guides/`);
// Share image for link previews (site/og/ renders the default). Absolute URLs, as crawlers need.
const share = image ?? { src: t.SHARE_IMAGE.src, alt: t.SHARE_IMAGE.alt, width: t.SHARE_IMAGE.width, height: t.SHARE_IMAGE.height };
const shareUrl = new URL(share.src, SITE_URL).href;
// WebSite + Organization structured data on the root chooser and each market home.
const siteLd = !market || isHome ? t.siteStructuredData({ site: siteInfo, siteUrl: SITE_URL, market }) : '';
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
{description && <meta name="description" content={description}>}
{robots && <meta name="robots" content={robots}>}
{!noindex && <link rel="canonical" href={`${SITE_URL}${path}`}>}
{alternates.map(({ m, href }) => <link rel="alternate" hreflang={`${m.language}-${m.id}`} href={`${SITE_URL}${href}`}>)}
<link rel="alternate" hreflang="x-default" href={`${SITE_URL}${xDefault}`}>
<meta property="og:type" content={pageId ? 'article' : 'website'}>
<meta property="og:site_name" content={siteInfo.name}>
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description}>}
<meta property="og:url" content={`${SITE_URL}${path}`}>
<meta property="og:locale" content={ogLocale}>
<meta property="og:image" content={shareUrl}>
<meta property="og:image:width" content={String(share.width)}>
<meta property="og:image:height" content={String(share.height)}>
<meta property="og:image:alt" content={share.alt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={shareUrl}>
<meta name="twitter:image:alt" content={share.alt}>
{gscToken && <meta name="google-site-verification" content={gscToken}>}
<meta name="color-scheme" content="light">
<meta name="theme-color" content="#ffffff">
<link rel="preload" href="/assets/fonts/schibsted-grotesk.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href={t.assetUrl('/assets/site.css')}>
<link rel="icon" href={t.assetUrl('/assets/icon.svg')} type="image/svg+xml">
<link rel="apple-touch-icon" href={t.LOGO.src}>
<link rel="manifest" href="/manifest.webmanifest">
{siteLd && <Fragment set:html={siteLd} />}
{gtm && <Analytics id={gtm} market={market?.id} pageId={pageId} />}
</head>
<body class={bodyClass} data-page={pageId}>
<a class="skip" href="#main">Skip to content</a>
{preview && <div class="preview-bar">Preview build · mock prices · not public</div>}
{market && (
<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href={`/${market.locale}/`} aria-label={`${spokenName(siteInfo.name)}, home`} set:html={brandMark(siteInfo.name)} />
    <nav class="nav" aria-label="Main">
      {siteInfo.categories.map((c) => <a href={`/${market.locale}/${c.id}/`}>{navLabel(c)}</a>)}
      {hasGuides && <a href={`/${market.locale}/guides/`}>All guides</a>}
      <span class="market" role="group" aria-label="Market">
        {switcher.map(({ m, href }) => <a href={href} hreflang={`${m.language}-${m.id}`} data-market={m.locale} aria-current={m.id === market.id ? 'true' : undefined}>{shortLabel(m)}</a>)}
      </span>
    </nav>
  </div>
</header>
)}
<main id="main">
<slot />
</main>
{market && (
<footer class="foot">
  <div class="wrap">
    {disclosure && <p class="disclosure">{disclosure}</p>}
    <p class="foot-links"><span class="brand-inline">{siteInfo.name}</span> <a href={`/${market.locale}/how-we-work/`}>How we work</a> <a href={`/${market.locale}/how-we-work/#disclosure`}>Disclosure</a> {hasGuides && <a href={`/${market.locale}/guides/`}>All guides</a>} <a href="mailto:hello@yourcoffeesetup.com">hello@yourcoffeesetup.com</a>{gtm && <button type="button" class="link-button" id="consent-settings" hidden>Cookie settings</button>}</p>
  </div>
</footer>
)}
{gtm && (
<section class="consent" id="consent" aria-label="Cookie choice" hidden>
  <div class="wrap consent-inner">
    <p class="consent-text">Can we use analytics cookies? Google Analytics would count visits and show us which guides help. No ads, and nothing is sold. You can change this any time under Cookie settings at the bottom of the page.</p>
    <div class="consent-actions">
      <button type="button" id="consent-accept">Accept</button>
      <button type="button" id="consent-reject">Reject</button>
    </div>
  </div>
</section>
)}
<script is:inline src={t.assetUrl('/assets/site.js')} defer></script>
{gtm && <script is:inline src={t.assetUrl('/assets/consent.js')} defer></script>}
</body>
</html>
