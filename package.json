{
  "name": "coffee-research",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node engine/state/validate-repo.mjs && node agent/validate-knowledge.mjs",
    "tick": "node engine/scheduler/tick.mjs",
    "item": "node engine/state/item-cli.mjs",
    "feedback": "FEEDBACK_TOOL=feedback node engine/feedback/cli.mjs",
    "prompt": "FEEDBACK_TOOL=prompt node engine/feedback/cli.mjs",
    "schedule": "node ops/schedule.mjs",
    "site:build": "astro build --root site",
    "site:preview": "astro dev --root site --port 4321",
    "dashboard": "node backoffice/server.mjs",
    "seed": "node engine/state/seed-cli.mjs",
    "site:build:production": "SITE_MODE=production astro build --root site"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "wrangler": "^4.166.0"
  }
}
